{
  "name": "celbrico-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Celbrico E-commerce Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "api/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.10.12",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
