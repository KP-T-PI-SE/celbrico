# Backend API Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/celbrico
JWT_SECRET=your_production_jwt_secret_key_change_me
REFRESH_SECRET=your_production_refresh_secret_key_change_me

# Razorpay Payment Gateway (Test sandbox or Live keys)
