RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
FRONTEND_URL=http://localhost:3000
